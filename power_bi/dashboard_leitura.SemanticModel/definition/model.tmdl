model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["book_analytics dim_livros","book_analytics fato_assinatura","book_analytics fato_leituras","_Medidas","book_analytics dim_livros_categorias"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'book_analytics dim_livros'
ref table 'book_analytics fato_assinatura'
ref table 'book_analytics fato_leituras'
ref table dim_calendario
ref table _Medidas
ref table 'book_analytics dim_livros_categorias'

ref cultureInfo pt-BR

