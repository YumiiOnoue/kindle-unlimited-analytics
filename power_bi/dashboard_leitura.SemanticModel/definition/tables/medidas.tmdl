table Medidas
	lineageTag: 090311b6-a588-4c36-a417-591413c59cf7

	measure 'Livros Concluidos' =
			
			CALCULATE(
			    COUNTROWS('book_analytics fato_leituras'),
			    'book_analytics fato_leituras'[status_leitura] = "Lido",
			    NOT ISBLANK('book_analytics fato_leituras'[data_fim])
			)
		formatString: 0
		lineageTag: b86d99b5-0fb4-44e1-af3b-739a0d286830

	measure 'Livros Em Andamento' = ```
			
			CALCULATE(
			    COUNTROWS('book_analytics fato_leituras'),
			    'book_analytics fato_leituras'[status_leitura] = "Lendo", 
			    USERELATIONSHIP(dim_calendario[Date], 'book_analytics fato_leituras'[data_inicio])
			)
			```
		formatString: 0
		lineageTag: e88c65d4-128e-438f-a81d-f211abc66e4c

	measure 'Livros Abandonados' = ```
			
			CALCULATE(
			    COUNTROWS('book_analytics fato_leituras'),
			    'book_analytics fato_leituras'[status_leitura] = "Abandonado" 
			)+0
			```
		formatString: 0
		lineageTag: 777f668d-7e65-4515-94c5-99c464485911

	measure 'Tempo Medio Leitura (Dias)' = ```
			
			AVERAGEX(
			    FILTER(
			        'book_analytics fato_leituras',
			        'book_analytics fato_leituras'[status_leitura] = "Lido"
			            && NOT ISBLANK('book_analytics fato_leituras'[data_inicio])
			            && NOT ISBLANK('book_analytics fato_leituras'[data_fim])
			            && 'book_analytics fato_leituras'[data_fim] >= 'book_analytics fato_leituras'[data_inicio]
			    ),
			    DATEDIFF(
			        'book_analytics fato_leituras'[data_inicio],
			        'book_analytics fato_leituras'[data_fim],
			        DAY
			    ) + 1
			)
			
			```
		formatString: 0
		lineageTag: 53d91ecb-8b3f-4a53-8af4-6bacdf0bde86

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Custo Total Assinatura' =
			
			CALCULATE(
			    SUM('book_analytics fato_assinatura'[valor_mensal]),
			    'book_analytics fato_assinatura'[servico] = "Kindle+"
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 3587935c-6f9d-441b-ac3a-c971a43d1dbe

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure meta_leitura = 15
		formatString: 0
		lineageTag: f13183a2-f8bf-4603-af5c-d212226bd38a

	measure 'Livros Kindle+ Concluidos' = ```
			
			CALCULATE(
			    [Livros Concluidos],
			    'book_analytics fato_leituras'[origem_acesso] = "Kindle+"
			)
			
			```
		formatString: 0
		lineageTag: 0ceb3075-892b-4ad3-a8f8-3cc7e5254f80

	measure 'Custo Kindle+ por Livro Concluido' = ```
			
			DIVIDE(
			    [Custo Total Assinatura],
			    [Livros Kindle+ Concluidos]
			)
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: f9d2e0d2-4cff-4f3d-b07b-12c225f34030

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Valor Referencia Digital Kindle+' = ```
			
			CALCULATE(
			    SUMX(
			        'book_analytics fato_leituras',
			        VAR Preco =
			            RELATED('book_analytics dim_livros'[preco_digital])
			        RETURN
			            IF(
			                NOT ISBLANK(Preco) && Preco > 0,
			                Preco,
			                BLANK()
			            )
			    ),
			    'book_analytics fato_leituras'[origem_acesso] = "Kindle+",
			    'book_analytics fato_leituras'[status_leitura] = "Lido",
			    NOT ISBLANK('book_analytics fato_leituras'[data_fim])
			)
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d500a3c8-e9c7-42d0-8536-7574bc04b7c1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Diferenca Referencia vs Kindle+' = ```
			
			[Valor Referencia Digital Kindle+] -
			[Custo Total Assinatura]
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 70f409de-d5f5-4f5c-afb7-1b80dbf6e49b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Multiplo Referencia vs Kindle+' = ```
			
			DIVIDE(
			    [Valor Referencia Digital Kindle+],
			    [Custo Total Assinatura]
			)
			
			```
		lineageTag: ed9464a0-fd30-4741-9bd9-251fe0b9be0e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nota Media' = ```
			
			AVERAGE('book_analytics fato_leituras'[nota])
			
			```
		formatString: 0.00
		lineageTag: 03c1d04c-2353-4231-832f-877a72020aab

	measure 'Nota Media Livros Concluidos' = ```
			
			CALCULATE(
			    [Nota Media],
			    'book_analytics fato_leituras'[status_leitura] = "Lido",
			    NOT ISBLANK('book_analytics fato_leituras'[data_fim])
			)
			
			```
		lineageTag: 79c4aed5-7b8b-48b4-9454-4c6f03fecf1f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Titulos Distintos Concluidos' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('book_analytics fato_leituras'[id_livro]),
			    'book_analytics fato_leituras'[status_leitura] = "Lido",
			    NOT ISBLANK('book_analytics fato_leituras'[data_fim])
			)
			
			```
		formatString: 0
		lineageTag: d955b0e5-afe6-44d8-8650-4ce734ee43c4

	measure 'Leituras Iniciadas' =
			
			CALCULATE(
			    COUNTROWS('book_analytics fato_leituras'),
			    USERELATIONSHIP(
			        dim_calendario[Date],
			        'book_analytics fato_leituras'[data_inicio]
			    )
			)
		formatString: 0
		lineageTag: e20e54fa-0062-4046-b608-8275cd8b8ffd

	measure 'Total de Leituras' =
			
			COUNTROWS('book_analytics fato_leituras')
		formatString: 0
		lineageTag: f566bbac-1fb3-400b-8659-279a71dbf411

	measure 'Percentual Concluído' =
			
			DIVIDE(
			    [Livros Concluidos],
			    [Total de Leituras],
			    0
			)
		lineageTag: 4d54891a-97a2-4e80-8965-a310569c0b06

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total de Páginas Lidas' =
			
			CALCULATE(
			    SUM('book_analytics dim_livros'[numero_paginas]),
			    'book_analytics fato_leituras'[status_leitura] = "Lido"
			)
		formatString: 0
		lineageTag: eebe8c90-d83d-4ad4-8174-5f2d34522612

	measure 'Média de Páginas por Livro' =
			
			AVERAGEX(
			    FILTER(
			        'book_analytics fato_leituras',
			        'book_analytics fato_leituras'[status_leitura] = "Lido"
			    ),
			    RELATED('book_analytics dim_livros'[numero_paginas])
			)
		lineageTag: fbc0d74c-8c5d-4567-af86-8b5a64ff5037

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gasto Total Registrado' =
			
			[Gastos Efetivos com Compras]
			    + [Custo Total Assinatura]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d980b48d-b800-4f57-86f0-85a13bcd1015

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Gastos Efetivos com Compras' =
			
			CALCULATE(
			    SUMX(
			        'book_analytics fato_leituras',
			        SWITCH(
			            'book_analytics fato_leituras'[formato],
			            "Digital",
			                RELATED('book_analytics dim_livros'[preco_digital]),
			            "Físico",
			                RELATED('book_analytics dim_livros'[preco_fisico]),
			            BLANK()
			        )
			    ),
			    'book_analytics fato_leituras'[origem_acesso] = "Compra"
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 38eccaa8-3f24-4f31-a691-b1f027502ce1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Livros Lidos com Motivação de Leitura' =
			
			CALCULATE(
			    DISTINCTCOUNT('book_analytics fato_leituras'[id_livro]),
			    'book_analytics fato_leituras'[status_leitura] = "Lido",
			    'book_analytics fato_leituras'[motivacao_leitura] = "Sim"
			)
		formatString: 0
		lineageTag: 015321f3-42db-427d-a90e-10973a0e1492

	measure '% Livros com Motivação de Leitura' =
			
			DIVIDE(
			    [Livros Lidos com Motivação de Leitura],
			    [Livros Kindle+ Concluidos],
			    0
			)
		lineageTag: 18500d0a-e6cf-4133-948d-f71a662ef101

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nota Media outras origens' =
			
			CALCULATE(
			    [Nota Media],
			    'book_analytics fato_leituras'[origem_acesso] <> "Kindle+"
			)
		lineageTag: 9592b3fd-b425-42c0-a688-e5c94f51de4d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Meses Sem Conclusão Kindle+' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('dim_calendario'[AnoMes]),
			        [Meses Assinados Kindle+] > 0 &&
			        (ISBLANK([Livros Kindle+ Concluidos]) || [Livros Kindle+ Concluidos] = 0)
			    )
			)
		lineageTag: e1f57b06-5cc2-4eb3-bcb8-e46347e33c27

	measure 'Meses Assinados Kindle+' =
			
			CALCULATE(
			    DISTINCTCOUNT('book_analytics fato_assinatura'[id_assinatura]),
			    'book_analytics fato_assinatura'[servico] = "Kindle+"
			)
		formatString: 0
		lineageTag: 036a7205-7af8-4789-83ed-366c7b84f226

	measure 'Valor Referencia Acumulado Kindle+' =
			
			CALCULATE(
			    [Valor Referencia Digital Kindle+],
			    FILTER(
			        ALL('dim_calendario'),
			        'dim_calendario'[Date] <= MAX('dim_calendario'[Date])
			    )
			)
		lineageTag: de01fbda-da7a-4c3e-8d62-9b8b1552b5a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Investimento Acumulado Kindle+' =
			
			CALCULATE(
			    [Custo Total Assinatura],
			    FILTER(
			        ALL('dim_calendario'),
			        'dim_calendario'[Date] <= MAX('dim_calendario'[Date])
			    )
			)
		lineageTag: cc875818-7a7d-420e-8967-49b731e404a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Custo Total Compras Lidos' =
			
			CALCULATE(
			    SUMX(
			        'book_analytics fato_leituras',
			        IF(
			            'book_analytics fato_leituras'[formato] = "Digital",
			            RELATED('book_analytics dim_livros'[preco_digital]),
			            RELATED('book_analytics dim_livros'[preco_fisico])
			        )
			    ),
			    'book_analytics fato_leituras'[origem_acesso] = "Compra",
			    'book_analytics fato_leituras'[status_leitura] = "Lido"
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 3ae90dbd-c08b-4cc5-861b-842959170d7f

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Cor Aproveitamento Kindle+' =
			
			VAR Qtde = [Livros Kindle+ Concluidos]
			VAR Ref = [Valor Referencia Digital Kindle+]
			VAR Mensalidade = [Custo Total Assinatura]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Mensalidade) || Mensalidade = 0, BLANK(),
			    Qtde = 0 || ISBLANK(Qtde), "#D9534F", // Ocioso (0 livros)
			    Qtde = 1 || Ref < Mensalidade, "#E07A5F", // Baixo aproveitamento (1 livro ou valor de ref. abaixo da mensalidade)
			    "#52796F" // Bom aproveitamento (2+ livros e acima do break-even)
			)
		lineageTag: 904eaaa8-287a-4624-8582-94a0ebd95e7f

	measure 'Meses Cobertos Kindle+' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('dim_calendario'[AnoMes]),
			        [Custo Total Assinatura] > 0 &&
			        [Valor Referencia Digital Kindle+] >= [Custo Total Assinatura]
			    )
			)
		formatString: 0
		lineageTag: fbfa0e72-4653-4501-9b61-754837c08323

	measure '% Mensalidades Cobertas Kindle+' =
			
			DIVIDE(
			    [Meses Cobertos Kindle+],
			    [Meses Assinados Kindle+],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5fa10431-2a02-4d53-85ff-523eafaa1d18

	measure 'Subtitulo Economia Kindle+' =
			
			VAR Economia = [Valor Referencia Digital Kindle+] - [Custo Total Assinatura]
			RETURN
			"Ref.: " & FORMAT([Valor Referencia Digital Kindle+], "R$ #,##0.00") & " vs. Pago: " & FORMAT([Custo Total Assinatura], "R$ #,##0.00")
		lineageTag: 3ca0b2d2-a5fa-4975-be58-632c73ff1bde

	measure 'Subtitulo Mensalidades Cobertas' =
			
			VAR Cobertos = COALESCE([Meses Cobertos Kindle+], 0)
			VAR TotalMeses = COALESCE([Meses Assinados Kindle+], 0)
			RETURN
			Cobertos & " de " & TotalMeses & IF(TotalMeses = 1, " mês coberto", " meses cobertos")
		lineageTag: 5eed8c68-d99b-4d01-b43b-0737e0129a9b

	measure 'Total de Categorias' =
			
			COUNTROWS('book_analytics dim_categoria')
		formatString: 0
		lineageTag: 954ab153-a785-4461-beb9-aaccec6b093d

	measure 'Livros Concluidos Outras Origens' =
			
			CALCULATE(
			    [Livros Concluidos],
			    'book_analytics fato_leituras'[origem_acesso] <> "Kindle+"
			)
		formatString: 0
		lineageTag: 805bac4c-8a90-41d5-9070-f43edd7a5f98

	measure 'Nota Media Kindle+' =
			
			CALCULATE(
			    [Nota Media],
			    'book_analytics fato_leituras'[origem_acesso] = "Kindle+"
			)
		lineageTag: 60e1fa06-9639-44b3-9c81-8e4d97be5caa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Livros Intencao Previa' =
			
			CALCULATE(
			    [Livros Concluidos],
			    'book_analytics fato_leituras'[motivacao_leitura] = "Sim"
			)
		formatString: 0
		lineageTag: 10a5d493-7da0-455c-bed3-014c2214441a

	measure 'Livros Descoberta' =
			
			CALCULATE(
			    [Livros Concluidos],
			    'book_analytics fato_leituras'[motivacao_leitura] = "Não"
			)
		formatString: 0
		lineageTag: 560b96f7-bcee-4726-bdb8-175537b30210

	measure '% Descoberta Categoria' =
			
			DIVIDE([Livros Descoberta], [Livros Concluidos], 0)
		lineageTag: 4b1b70be-7480-4285-af72-e063737cdf9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Notas em Ambas Origens' =
			
			IF(
			    NOT(ISBLANK([Nota Media Kindle+])) && NOT(ISBLANK([Nota Media Outras Origens])),
			    1,
			    0
			)
		lineageTag: 668948c9-a5c7-4126-a902-42f32f8c61d1

	measure 'Total Autores Lidos' =
			
			CALCULATE(
			    DISTINCTCOUNT('book_analytics dim_livros'[autor]),
			    'book_analytics fato_leituras'[status_leitura] = "Lido"
			)
		formatString: 0
		lineageTag: f4e10b15-58dd-4438-8d80-ba0f7144866a

	measure 'Total Editoras' =
			
			DISTINCTCOUNT('book_analytics dim_livros'[editora])
		formatString: 0
		lineageTag: ae5a60dc-49b9-48c3-b519-0e246209ec9c

