	partition dim_calendario = calculated
		mode: import
		source =
				
				VAR DataMinima = DATE(2021, 1, 1) -- Primeiro ano com leituras no seu histórico
				VAR DataMaxima = DATE(YEAR(TODAY()), 12, 31)
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(DataMinima, DataMaxima),
				    "Ano", YEAR([Date]),
				    "MesNum", MONTH([Date]),
				    "NomeMes", FORMAT([Date], "mmmm"),
				    "MesAbrev", FORMAT([Date], "mmm"),
				    "AnoMesNum", YEAR([Date]) * 100 + MONTH([Date]),
				    "AnoMes", FORMAT([Date], "mm/yyyy"),
				    "Trimestre", "T" & FORMAT([Date], "q"),
				    "TrimestreAno", "T" & FORMAT([Date], "q") & "/" & YEAR([Date]),
				    "DiaSemanaNum", WEEKDAY([Date], 2), -- 1 = Segunda, 7 = Domingo
				    "DiaSemana", FORMAT([Date], "dddd"),
				    "DiaSemanaAbrev", FORMAT([Date], "ddd")
				)

	annotation PBI_Id = 41206663feb54310ac1a75db7f2fb8e0

