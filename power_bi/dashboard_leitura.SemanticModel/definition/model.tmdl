model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["book_analytics dim_livros","book_analytics fato_assinatura","book_analytics fato_leituras","_Medidas","book_analytics dim_categoria","book_analytics livro_categoria","Consulta"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'book_analytics dim_livros'
ref table 'book_analytics fato_assinatura'
ref table 'book_analytics fato_leituras'
ref table dim_calendario
ref table 'book_analytics dim_categoria'
ref table 'book_analytics livro_categoria'
ref table Medidas
ref table Consulta

ref cultureInfo pt-BR

